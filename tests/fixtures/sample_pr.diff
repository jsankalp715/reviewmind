+def generate_report(user_ids):
+    results = []
+    for uid in user_ids:
+        user = get_user_from_db(uid)
+        orders = get_orders_from_db(uid)
+        for order in orders:
+            items = get_items_from_db(order.id)
+            for item in items:
+                results.append(item.name + " - " + str(item.price))
+    return results
