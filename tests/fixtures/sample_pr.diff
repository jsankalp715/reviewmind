+def process_data(data):
+    processed = []
+    for i in range(len(data)):
+        for j in range(len(data)):
+            if data[i] > data[j]:
+                processed.append(data[i])
+    return processed
+
+
+def get_all_records():
+    conn = get_db_connection()
+    return conn.execute("SELECT * FROM records").fetchall()
