# Copy to .env and fill in. Every setting can also be passed as a plain environment variable.
# Never commit .env (it is in .gitignore).

# --- LLM ---------------------------------------------------------------------
# gemini | mock   (mock is offline and deterministic: for local development and demos)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=0.2
# GEMINI_REQUEST_TIMEOUT_SECONDS=90

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT with "Pull requests: Read and write" + "Contents: Read" on the target repos.
GITHUB_TOKEN=your_github_token_here
# Must match the secret configured on the GitHub webhook. Webhooks are rejected if unset.
GITHUB_WEBHOOK_SECRET=generate_with_python_-c_import_secrets_print_secrets.token_hex_32
# POST_REVIEWS=true            # false = review and store, but don't post to the PR
# GITHUB_API_URL=https://api.github.com
# GITHUB_MAX_RETRIES=4
# GITHUB_BACKOFF_BASE_SECONDS=1.0
# GITHUB_BACKOFF_MAX_SECONDS=60

# --- Agents / concurrency ----------------------------------------------------
# AGENT_TIMEOUT_SECONDS=60      # per LLM attempt, per chunk
# AGENT_MAX_RETRIES=1           # retries after the first attempt, before degrading
# AGENT_RETRY_BACKOFF_SECONDS=1
# LLM_MAX_CONCURRENCY=4         # max in-flight LLM calls across all agents and reviews
# ENABLED_AGENTS=["security","performance","documentation","tests"]

# --- Chunking ----------------------------------------------------------------
# CHUNK_MAX_TOKENS=6000         # per-chunk budget (estimated as characters / CHARS_PER_TOKEN)
# CHARS_PER_TOKEN=4
# MAX_CHUNKS_PER_REVIEW=40      # files beyond this are listed as skipped, not truncated

# --- Server ------------------------------------------------------------------
# DATABASE_PATH=reviewmind.db
# LOG_LEVEL=INFO
# LOG_FORMAT=json               # json | text
# PORT=8000
